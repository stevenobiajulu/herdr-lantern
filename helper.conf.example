# Lantern configuration. launch.sh parses KEY=value lines only;
# it does not source this file as shell.

# Which agent CLI runs the helper chat. One of: agent, devin, claude, codex, grok, pi.
# `cursor` is an alias for `agent` (Cursor CLI). Empty: model-policy.json
# helper.agent when set, otherwise the first of agent, devin, claude, codex,
# grok, pi on PATH.
HELPER_AGENT=""

# Optional --model. For devin, leave empty (uses ~/.config/devin/config.json).
# Empty uses model-policy.json helper.model when HELPER_AGENT matches
# helper.agent. For Cursor `agent`, empty otherwise uses
# routes.cursor.helper_model from model-policy.json.
HELPER_MODEL=""

# Optional provider. pi only: passed as --provider <value>. Unused by the other helpers.
HELPER_PROVIDER=""

# Optional reasoning effort. Mapped per agent:
#   codex  -> --config model_reasoning_effort="<value>"
#   claude -> --effort <value>
#   grok   -> --reasoning-effort <value>
#   pi     -> --thinking <value>
#   devin / agent -> unused (pick a model id that already includes effort)
# Empty uses model-policy.json helper.effort under the same rule as the model.
HELPER_EFFORT=""

# Search root mentioned to the helper. Process cwd is a plugin state workdir.
HELPER_CWD="~"

# Default seat when the user names a repo and no harness, model, or
# setting. Kind is the herdr --kind (claude, cursor, grok, codex, …).
# Model is a spoken phrase or catalog id; empty uses that kind’s live
# default. Set these from the lantern chat ("make X my default spawn")
# or with `bin/onboard apply`. Codex example: model "astra high".
# Claude example: "opus" with effort "high". Aliases resolve through the
# live CLI catalog. Empty kind uses the model-policy.json spawn default
# (shipped: claude, live default). The model policy can forbid a phrase;
# see docs/model-policy.md.
HELPER_SPAWN_KIND=""
HELPER_SPAWN_MODEL=""
HELPER_SPAWN_EFFORT=""

# Permission mode:
#   devin: auto | accept-edits | smart (default) | dangerous
#   agent:   smart/accept-edits -> --auto-review; dangerous -> --force
#   pi: accepted and ignored — Pi has no permission flags; Lantern passes none
# Mutating herdr still requires HERDR_HELPER_OK=1 after the user confirms.
HELPER_PERMISSION="smart"

# Extra CLI tokens appended before the prompt. Unquoted words only.
HELPER_EXTRA_ARGS=""
